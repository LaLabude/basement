name: Build Basement (macOS)

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4

      - name: Configure
        run: cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_OSX_ARCHITECTURES="arm64;x86_64"

      - name: Build
        run: cmake --build build --config Release --parallel

      - name: Sign (ad-hoc) and zip
        run: |
          VST3=$(find build -name "Basement.vst3" -type d | head -n 1)
          echo "Found: $VST3"
          codesign --force --deep -s - "$VST3"
          mkdir -p dist
          ditto -c -k --keepParent "$VST3" dist/Basement-vst3-mac.zip

      - name: Upload
        uses: actions/upload-artifact@v4
        with:
          name: Basement-VST3-macOS
          path: dist/Basement-vst3-mac.zip
